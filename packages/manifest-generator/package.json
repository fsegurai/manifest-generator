{
  "name": "@fsegurai/manifest-generator",
  "version": "1.0.0",
  "description": "A simple manifest and search-index generator based on project documentation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "browser": "./dist/index.umd.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "manifest-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./cli": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsegurai/manifest-generator.git"
  },
  "homepage": "https://github.com/fsegurai/manifest-generator#readme",
  "bugs": {
    "url": "https://github.com/fsegurai/manifest-generator/issues"
  },
  "keywords": [
    "cli",
    "docs",
    "documentation",
    "generator",
    "javascript",
    "javascript-library",
    "lightweight",
    "library",
    "manifest",
    "manifest-generator",
    "markdown",
    "search-index",
    "typescript",
    "typescript-library"
  ],
  "author": {
    "name": "Fabián Segura",
    "url": "https://www.fsegurai.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0",
    "npm": ">=11"
  },
  "scripts": {
    "pkg:build": "vite build && vite build -c vite.cli.config.ts",
    "pkg:test": "bun test",
    "pkg:test:coverage": "bun test --coverage"
  },
  "peerDependencies": {},
  "dependencies": {
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {}
}
