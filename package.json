{
  "name": "@fsegurai/manifest-generator-monorepo",
  "version": "1.0.0-beta.2",
  "description": "A simple manifest and search-index generator based on project documentation.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Fabián Segura",
    "url": "https://fsegurai.com"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0",
    "npm": ">=10"
  },
  "keywords": [
    "cli",
    "docs",
    "documentation",
    "generator",
    "javascript",
    "lightweight",
    "library",
    "manifest",
    "manifest-generator",
    "markdown",
    "search-index",
    "typescript"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "bun run clean",
    "build": "bun run build:packages && bun run build:demo",
    "postbuild:demo": "cp ./README.md ./demo/dist/README.md && cp ./LICENSE ./demo/dist/LICENSE",
    "postbuild:packages": "find ./packages -maxdepth 1 -type d ! -name '.helper' ! -name 'packages' -exec cp ./LICENSE {} \\;",
    "build:packages": "bun run --filter '*' pkg:build",
    "build:demo": "vite build",
    "build:demo:dev": "vite dev",
    "build:doppler": "doppler run bun run build",
    "build:packages:doppler": "doppler run bun run build:packages && bun run postbuild:packages",
    "build:demo:doppler": "doppler run bun run build:demo && bun run postbuild:demo",
    "clean": "bun run clean:packages && bun run clean:demo",
    "clean:packages": "rimraf --glob ./packages/*/dist && rimraf --glob ./packages/*/LICENSE",
    "clean:demo": "rimraf --glob ./demo/dist ./demo/README.md ./demo/LICENSE",
    "clean:coverage": "rimraf --glob ./coverage",
    "dev": "portless run vite serve",
    "dev:doppler": "doppler run bun run dev",
    "start": "bun run dev",
    "start:doppler": "bun run dev:doppler",
    "test": "bun run --filter '*' pkg:test",
    "test:coverage": "bun test --coverage",
    "test:snapshots": "bun test --update-snapshots",
    "test:summary": "bun run ./scripts/test-all-packages.ts --summary",
    "test:packages": "bun run --filter '*' pkg:test:coverage",
    "test:packages:snapshots": "bun run --filter '*' pkg:test -- --update-snapshots",
    "lint": "bun run lint:packages && bun run lint:demo",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "bun run lint:packages --fix && bun run lint:demo --fix",
    "lint:packages": "eslint ./packages/*/src/**",
    "lint:demo": "eslint ./demo",
    "generate:manifest": "bun ./packages/manifest-generator/src/cli.ts --docs-root ./docs/ --output ./docs",
    "generate:manifest-all": "bun ./packages/manifest-generator/src/cli.ts --all --docs-root ./docs --output ./docs",
    "generate:manifest-current": "bun ./packages/manifest-generator/src/cli.ts --docs-root ./docs/$npm_package_version --output ./docs/$npm_package_version"
  },
  "dependencies": {
    "@material/web": "^2.4.1",
    "clipboard": "^2.0.11",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "bun-types": "^1.3.12",
    "eslint": "^9.39.1",
    "portless": "^0.10.3",
    "rimraf": "^6.1.2",
    "terser": "^5.46.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.0.8"
  }
}
